# mock: 키·네트워크 없이 동작 (개발·연동용) / gemini: 실제 검색
SEARCH_PROVIDER=mock

# gemini 모드에서만 필요 (Google AI Studio에서 발급)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_REFINE_MODEL=gemini-flash-lite-latest
# 질문을 검색어로 다듬을지 (gemini 모드에서만)
GEMINI_REFINE=true
# 질문 정제를 기다리는 최대 시간(초). 넘으면 원문으로 검색 (비우면 3)
GEMINI_REFINE_WAIT=
# 정제 검색어가 원문과 이 유사도보다 멀면 지어낸 것으로 보고 버림 (비우면 0.7)
REFINE_MIN_SIMILARITY=

CHROMA_PATH=./chroma_data

# 이 점수(코사인 유사도) 미만 결과는 버림. 비우면 모드별 기본값
MIN_SCORE=
# 1위보다 이만큼 이상 점수가 낮은 영상은 버림. 비우면 모드별 기본값(gemini 0.08), off면 끔
RELATIVE_MARGIN=
